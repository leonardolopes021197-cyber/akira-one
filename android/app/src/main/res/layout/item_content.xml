<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_round_10"
        android:clipToOutline="true"
        android:contentDescription="Capa"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="Nome"
            android:textColor="@color/akira_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Conteúdo Akira"
            android:textColor="@color/akira_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_soft"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_play"
        android:tint="#FFFFFF" />
</LinearLayout>
