<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/catalog_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/rowNumber"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/akira_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_round_10"
        android:clipToOutline="true"
        android:contentDescription="Logo ou capa"
        android:padding="3dp"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nome"
            android:textColor="@color/akira_text"
            android:textSize="16sp" />

        <!-- O que está passando agora no canal (fonte menor, embaixo do nome). -->
        <TextView
            android:id="@+id/rowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8F9BB3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Qualidade lida do nome do canal: SD, HD, FHD ou 4K. -->
    <TextView
        android:id="@+id/rowQuality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_quality_chip"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="HD"
        android:textColor="#AAB4C3"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Azul = canal selecionado / em foco. Transparente nos demais. -->
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_radio"
        android:tint="@color/live_icon_tint" />
</LinearLayout>
