<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_live"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ===== MENU LATERAL DE ÍCONES ===== -->
    <LinearLayout
        android:id="@+id/liveRail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

            <ImageView
                android:id="@+id/railSearch"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Pesquisar"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_search"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railHome"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Início"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_home"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLive"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="TV ao Vivo"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_tv"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railMovies"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Filmes"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_film"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railSeries"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Séries"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_series"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railFavorites"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Favoritos"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_heart"
                android:tint="@color/rail_icon_tint" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

            <ImageView
                android:id="@+id/railSettings"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Configurações"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_sliders"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLogout"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Sair da conta"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_logout"
                android:tint="@color/rail_icon_tint" />

    </LinearLayout>

    <!-- ===== CONTEÚDO ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Cabeçalho: logo, título, status e hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:contentDescription="Akira"
                android:scaleType="centerInside"
                android:src="@drawable/akira_brand" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="TV ao Vivo"
                android:textColor="@color/akira_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Carregando..."
                android:textColor="@color/akira_muted"
                android:textSize="11sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEE, MMM dd  HH:mm"
                android:format24Hour="EEE, MMM dd  HH:mm"
                android:textColor="@color/akira_text"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1">

            <!-- COLUNA 1: CATEGORIAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.26"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/categorySearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_search_muted"
                    android:hint="Pesquisar categoria"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- COLUNA 2: CANAIS (nome + o que está passando) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.38"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/catalogSearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_search_muted"
                    android:hint="Pesquisar canais"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/selectedCategoryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:text="Todos"
                    android:textColor="@color/akira_muted"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- COLUNA 3: EPG DO CANAL SELECIONADO -->
            <LinearLayout
                android:id="@+id/livePreviewPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.36"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/infoLogo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_round_14"
                        android:contentDescription="Logo do canal"
                        android:padding="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/akira_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_red"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="AO VIVO"
                            android:textColor="@color/akira_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/previewChannelTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="Selecione um canal"
                            android:textColor="@color/akira_text"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/infoHeart"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_icon_btn"
                        android:clickable="true"
                        android:contentDescription="Favoritar"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_heart"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.12"
                    android:text="PROGRAMAÇÃO"
                    android:textColor="@color/akira_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoEpgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Escolha um canal para ver a programação"
                    android:textColor="@color/akira_muted"
                    android:textSize="13sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/infoEpgList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                            android:id="@+id/infoWatchButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_watch"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.06"
                            android:text="▶  ASSISTIR"
                            android:textColor="@color/akira_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    <TextView
                        android:id="@+id/previewEpgButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/preview_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="EPG  ≡"
                        android:textColor="@color/akira_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Itens do preview antigo, mantidos ocultos por compatibilidade com o código. -->
                <TextView
                    android:id="@+id/previewFavoriteButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewQualityButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewInstruction"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewHint"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/livePreviewPlayer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:use_controller="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
