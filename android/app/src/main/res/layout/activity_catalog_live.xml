<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_live"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ===== MENU LATERAL DE ÍCONES ===== -->
    <LinearLayout
        android:id="@+id/liveRail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

            <ImageView
                android:id="@+id/railSearch"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Pesquisar"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_search"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railHome"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Início"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_home"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLive"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="TV ao Vivo"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_tv"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railMovies"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Filmes"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_film"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railSeries"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Séries"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_series"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railFavorites"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Favoritos"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_heart"
                android:tint="@color/rail_icon_tint" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

            <ImageView
                android:id="@+id/railSettings"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Configurações"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_sliders"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLogout"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Sair da conta"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_logout"
                android:tint="@color/rail_icon_tint" />

    </LinearLayout>

    <!-- ===== CONTEÚDO ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Cabeçalho: logo, título, status e data/hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:contentDescription="Akira"
                android:scaleType="centerInside"
                android:src="@drawable/akira_brand" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="TV ao Vivo"
                android:textColor="@color/akira_text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:text="Carregando..."
                android:textColor="@color/akira_muted"
                android:textSize="11sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEE, MMM dd  HH:mm"
                android:format24Hour="EEE, MMM dd  HH:mm"
                android:textColor="@color/akira_text"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1">

            <!-- CATEGORIAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.27"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/categorySearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:hint="Pesquisar categoria"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- CANAIS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.33"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/catalogSearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:hint="Pesquisar canais"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/selectedCategoryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:text="Todos"
                    android:textColor="@color/akira_muted"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- INFORMAÇÕES DO CANAL (sem vídeo: OK abre em tela cheia) -->
            <LinearLayout
                android:id="@+id/livePreviewPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.40"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/previewFrame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.40"
                    android:background="@drawable/bg_info_frame"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/infoLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Logo do canal"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/akira_icon" />

                    <TextView
                        android:id="@+id/previewHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="Pressione OK para assistir"
                        android:textColor="#8C98A6"
                        android:textSize="12sp" />

                    <!-- Mantido só por compatibilidade com o código do preview antigo (sempre oculto). -->
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/livePreviewPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:use_controller="false" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <TextView
                        android:id="@+id/previewChannelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Selecione um canal"
                        android:textColor="@color/akira_text"
                        android:textSize="24sp" />

                    <ImageView
                        android:id="@+id/infoHeart"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_btn"
                        android:clickable="true"
                        android:contentDescription="Favoritar"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_heart"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoEpgNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:text="Escolha um canal para ver a programação"
                    android:textColor="#F5D547"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/infoEpgNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="5dp"
                    android:maxLines="3"
                    android:paddingStart="4dp"
                    android:text=""
                    android:textColor="@color/akira_text"
                    android:textSize="14sp" />

                <!-- Campos do preview antigo, mantidos ocultos por compatibilidade. -->
                <TextView
                    android:id="@+id/previewInstruction"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/previewEpgButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="0.38"
                        android:background="@drawable/preview_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="EPG  ≡"
                        android:textColor="@color/akira_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/previewQualityButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/previewFavoriteButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="0.62"
                        android:background="@drawable/preview_button_bg"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Adicionar aos favoritos ♡"
                        android:textColor="@color/akira_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
