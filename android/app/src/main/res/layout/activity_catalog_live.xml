<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_live"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ===== A. BARRA LATERAL (10 ícones; rola só em telas muito baixas) ===== -->
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/liveRail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/railSearch"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Pesquisar"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_search"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railHome"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Início"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_home"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLive"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="TV ao Vivo"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_tv"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railRadio"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Rádio"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_radio"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railMovies"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Filmes"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_film"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railSeries"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Séries"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_series"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railRefresh"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Atualizar conteúdo"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_refresh"
                android:tint="@color/rail_icon_tint" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/railProfile"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Perfil do usuário"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_user"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railSettings"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Configurações"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_sliders"
                android:tint="@color/rail_icon_tint" />

            <ImageView
                android:id="@+id/railLogout"
                android:layout_width="@dimen/rail_item"
                android:layout_height="@dimen/rail_item"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:contentDescription="Sair da conta"
                android:focusable="true"
                android:padding="@dimen/rail_pad"
                android:src="@drawable/ic_logout"
                android:tint="@color/rail_icon_tint" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== CONTEÚDO ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 3. Cabeçalho: logo, título, hora e indicador de conexão -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:contentDescription="Akira"
                android:scaleType="centerInside"
                android:src="@drawable/akira_brand" />

            <!-- EDITE AQUI: texto do título (a referência usa "viver"). -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="TV ao Vivo"
                android:textColor="@color/akira_text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Carregando..."
                android:textColor="@color/akira_muted"
                android:textSize="11sp" />

            <TextClock
                android:id="@+id/liveClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEE, MMM dd  HH:mm"
                android:format24Hour="EEE, MMM dd  HH:mm"
                android:textColor="@color/akira_text"
                android:textSize="18sp" />

            <View
                android:id="@+id/connDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_green" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1">

            <!-- B. PAINEL DE CATEGORIAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.20"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/categorySearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:hint="Pesquisar categoria"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- C. PAINEL DE CANAIS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.28"
                android:background="@drawable/catalog_panel_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <EditText
                    android:id="@+id/catalogSearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/catalog_search_bg"
                    android:hint="Pesquisar canais"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/akira_text"
                    android:textColorHint="#8A94A3"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/selectedCategoryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:text="Todos"
                    android:textColor="@color/akira_muted"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- D. PAINEL DE REPRODUÇÃO (≈ metade da tela) -->
            <LinearLayout
                android:id="@+id/livePreviewPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.52"
                android:orientation="vertical">

                <!-- Vídeo 16:9 com os cantos de cima arredondados. OK = tela cheia.
                     A altura é calculada no CatalogActivity (16:9, no máximo 56% do painel). -->
                <FrameLayout
                    android:id="@+id/previewFrame"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_video_frame"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="@drawable/ring_focus_video">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/livePreviewPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:resize_mode="fit"
                        app:shutter_background_color="#000000"
                        app:use_controller="false" />

                    <TextView
                        android:id="@+id/previewHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Selecione um canal e pressione OK"
                        android:textColor="#8C98A6"
                        android:textSize="13sp" />
                </FrameLayout>

                <!-- Nome do canal + favorito -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <TextView
                        android:id="@+id/previewChannelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Nenhum canal selecionado"
                        android:textColor="@color/akira_text"
                        android:textSize="24sp" />

                    <ImageView
                        android:id="@+id/infoHeart"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_btn"
                        android:clickable="true"
                        android:contentDescription="Favoritar"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_heart"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <!-- Programação atual (amarelo) e próximos programas -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:paddingStart="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/infoEpgStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/akira_muted"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/infoEpgList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/previewEpgButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/preview_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="84dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="EPG  ≡"
                        android:textColor="@color/akira_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/previewFavoriteButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/preview_button_bg"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Adicionar aos favoritos ♡"
                        android:textColor="@color/akira_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Itens do preview antigo, mantidos ocultos por compatibilidade com o código. -->
                <TextView
                    android:id="@+id/previewQualityButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewInstruction"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
