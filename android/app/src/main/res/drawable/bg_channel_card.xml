<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#2A3858" android:endColor="#151B2B" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#14243F" />
            <stroke android:width="2dp" android:color="#3AA8FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#161C2B" android:endColor="#0E121C" />
            <stroke android:width="1dp" android:color="#1F2639" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
