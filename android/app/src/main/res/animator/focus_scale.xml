<?xml version="1.0" encoding="utf-8"?>
<!-- Efeito de foco para controle remoto: leve zoom no item focado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:duration="140" android:valueTo="1.04" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="140" android:valueTo="1.04" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:duration="140" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="140" android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
