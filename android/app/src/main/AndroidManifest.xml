<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/akira_icon"
        android:roundIcon="@drawable/akira_icon"
        android:label="Akira TV"
        android:theme="@style/Theme.Akira"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity android:name=".LoadingActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".EpgActivity" android:screenOrientation="landscape" />
        <activity android:name=".ListsActivity" android:screenOrientation="landscape" />
        <activity android:name=".FavoritesActivity" android:screenOrientation="landscape" />
        <activity android:name=".SearchActivity" android:screenOrientation="landscape" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".PlayerActivity" android:screenOrientation="landscape" />
        <activity android:name=".SeriesActivity" android:screenOrientation="landscape" />
        <activity android:name=".CatalogActivity" android:screenOrientation="landscape" />
        <activity android:name=".MainActivity" android:exported="false" android:screenOrientation="landscape" />

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
